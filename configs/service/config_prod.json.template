{
    "allowedRoles": {
      "admin": "${{ADMIN_ROLE_ID}}",
      "community-builder": "${{COMMUNITY-BUILDER}}",
      "mentor-relations": "${{MENTOR-RELATIONS}}"
    },
    "publicCommands": [
      "myprofile",
      "itsociety",
      "skills"
    ],
    "channels": {
      "donationsChannel": "${{DONATIONS_CHANNEL_ID}}",
      "logChannel": "${{LOG_CHANNEL_ID}}",
      "welcomeChannel": "${{WELCOME_CHANNEL_ID}}",
      "roleSelectionChannel": "${{ROLE_SELECTION_CHANNEL_ID}}",
      "registrationChannel": "${{REGISTRATION_CHANNEL_ID}}",
      "referralsChannel": "${{REFERRALS_CHANNEL_ID}}",
      "communityBuildersChannel": "${{COMMUNITY_BUILDERS_CHANNEL_ID}}",
      "onboardingCategory": "${{ONBOARDING_CATEGORY_ID}}",
      "mentorshipCategory": "${{MENTORSHIP_CATEGORY_ID}}"
    },
    "registrations": {
      "autoInvite": true,
      "title": "New Registration",
      "inviteEmoji": "📧",
      "remindAfter": 604800000,
      "email": [ "email", "Email Address" ]
    },
    "referrals": {
      "title": "New Invitation",
      "inviteEmoji": "📧",
      "remindEmoji": "🎗",
      "registeredEmoji": "🎫",
      "dormantEmoji": "💤",
      "remindAfter": 604800000,
      "email": "Invitee Email"
    },
    "donations": {
      "receiptEmoji": "🧾",
      "messagePrefix": "**New invoice is created**"
    },
    "onboarding": {
      "remindAfter": 172800000
    },
    "mentorship": {
      "remindAfter": 2592000000,
      "coordinatorRoles": [ "${{COORDINATOR_ROLE_ID}}" ],
      "domains": {
        "qa": "QA / Test",
        "se": "Software Engineering",
        "security": "Security",
        "data": "Data Technologies",
        "mobile": "Mobile Software Engineering",
        "devops": "Devops",
        "sf": "Salesforce"
      }
    },
    "clientId": "${{CLIENT_ID}}",
    "dataPartner": "notion",
    "emailPartner": "google",
    "guildId": "${{GUILD_ID}}",
    "logging": {
      "console": true,
      "discord": true
    },
    "partnerConfig": {
      "notion": {
        "keymappings": {
          "Discord Nickname": "nickname",
          "Discord Id": "id",
          "Discord Tag": "tag",
          "Groups": "groups",
          "Discord Invite": "invite",
          "Status": "Status",
          "Discord Form ID": "messageId"
        },
        "richTextKeys": [
          "Discord Nickname",
          "Discord Id",
          "Discord Tag",
          "Discord Invite",
          "Company",
          "Job Title",
          "Onboarding Channel",
          "Discord Form ID"
        ],
        "optionMappings": {
          "title": "Job Title",
          "company": "Company",
          "name": "Full Name",
          "email": "Email Address"
        },
        "skills": [
          "Programming Languages",
          "Software Frameworks",
          "Additional Tooling",
          "Data Technologies",
          "Cloud Technologies"
        ],
        "request": {
          "baseURL": "https://api.notion.com/v1",
          "registationDatabase": "${{REGISTRATION_DATABASE_ID}}",
          "skillDatabase": "${{SKILL_DATABASE_ID}}",
          "referralDatabase": "${{REFERRAL_DATABASE_ID}}",
          "mentorshipDatabase": "${{MENTORSHIP_DATABASE_ID}}",
          "headers": {
            "Notion-Version": "2022-06-28",
            "Authorization": "${{NOTION_API_SECRET}}",
            "Content-Type": "application/json"
          }
        }
      },
      "google": {
        "credentials": {
          "client_id": "${{GOOGLE_CLIENT_ID}}",
          "project_id": "${{GOOGLE_PROJECT_ID}}",
          "auth_uri": "https://accounts.google.com/o/oauth2/auth",
          "token_uri": "https://oauth2.googleapis.com/token",
          "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
          "client_secret": "${{GOOGLE_CLIENT_SECRET}}",
          "redirect_uris": [
            "http://localhost"
          ],
          "tokens": {
            "refresh_token": "${{GOOGLE_REFRESH_TOKEN}}"
          }
        },
        "email": {
          "defaults": {
            "replyTo": "info@itsociety.org",
            "from": "IT Society<info@itsociety.org>",
            "headers": [
              { "key": "X-Application-Developer", "value": "Tyson Turkoz" },
              { "key": "X-Application-Version", "value": "v1.0.0" }
            ],
            "text": "This email is sent by IT Society Discord Server",
            "textEncoding": "base64"
          },
          "templates": {
            "donationReceipt": "donationReceipt.html",
            "welcomeEmail": "welcomeEmail.html",
            "landingEmail": "landingEmail.html",
            "reInviteEmail": "reInviteEmail.html",
            "joinBackEmail": "joinBackEmail.html",
            "referralEmail": "referralEmail.html",
            "referralReminderEmail": "referralReminderEmail.html",
            "referrerAckEmail": "referrerAckEmail.html",
            "onboardingAssignmentEmail": "onboardingAssignmentEmail.html",
            "onboardingReminderEmail": "onboardingReminderEmail.html",
            "onboardingSecondReminderEmail": "onboardingSecondReminderEmail.html",
            "mentorAssignmentEmail": "mentorAssignmentEmail.html"
          },
          "domain": "itsociety.org"
        }
      }
    },
    "startUpCorrelatation": false,
    "syncPeriodActivityInMentorshipChannels": 86400000,
    "syncPeriod": 300000,
    "token": "${{DISCORD_BOT_TOKEN}}"
}

